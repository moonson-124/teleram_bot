SUBJECTS_BY_CLASS = {
    "5": ["Биология", "Математика"],
    "7": ["Биология", "Алгебра", "Геометрия", "Физика"],
    "8": ["Биология", "Алгебра", "Геометрия", "Физика", "Химия"],
}

